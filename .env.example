# Core application
EXPEDIENTE_DATABASE_URL=postgresql+psycopg://expediente:change-me@db/expediente
EXPEDIENTE_BOOTSTRAP_TOKEN=replace-with-a-long-random-value

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EXPEDIENTE_TOKEN_ENCRYPTION_KEY=replace-with-a-fernet-key
EXPEDIENTE_OAUTH_STATE_SECRET=replace-with-at-least-32-random-bytes

# Google OAuth: never commit the real values
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.example/integrations/google/callback
GOOGLE_CALENDAR_WEBHOOK_URL=https://your-domain.example/webhooks/google/calendar

# Meta / WhatsApp Business Platform
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
META_GRAPH_VERSION=v23.0
META_WEBHOOK_VERIFY_TOKEN=replace-with-a-long-random-value
